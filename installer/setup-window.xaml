<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QuadFinder 설치" Width="620" Height="540" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" Background="#202020" Foreground="#E3E3E3" FontFamily="Segoe UI, Malgun Gothic" FontSize="14" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#E3E3E3"/><Setter Property="BorderBrush" Value="#454545"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D2D8E0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#181818"/><Setter Property="Foreground" Value="#E3E3E3"/><Setter Property="BorderBrush" Value="#414141"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="CaretBrush" Value="#E3E3E3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C5C5C5"/><Setter Property="Margin" Value="0,0,0,15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="16" Height="16" CornerRadius="3" Background="#181818" BorderBrush="#777777" BorderThickness="1" VerticalAlignment="Center"><TextBlock x:Name="Mark" Text="✓" Foreground="#202020" FontSize="12" HorizontalAlignment="Center" Visibility="Hidden"/></Border><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#C5CDD7"/><Setter TargetName="Box" Property="BorderBrush" Value="#C5CDD7"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border BorderBrush="#414141" BorderThickness="1" Padding="0">
 <Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
  <Grid Name="TitleBar" Background="Transparent" Margin="24,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Image Name="AppIcon" Width="22" Height="22"/><TextBlock Grid.Column="1" Text="QuadFinder" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/><Button Name="CloseButton" Grid.Column="2" Content="×" FontSize="23" Background="Transparent" BorderThickness="0" Padding="0" Width="32" Height="32" VerticalAlignment="Center" AutomationProperties.Name="닫기"/></Grid>
  <Grid Grid.Row="1" Margin="32,15,32,16">
   <StackPanel Name="WelcomePage" VerticalAlignment="Center">
    <TextBlock Text="QuadFinder에 오신 것을 환영합니다" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" TextWrapping="Wrap"/>
    <TextBlock Text="파일 검색과 탐색을 하나의 작업 공간에서.&#10;QuadFinder 설치를 시작합니다." Foreground="#A5A5A5" LineHeight="23" Margin="0,0,0,28"/>
    <Border Background="#181818" CornerRadius="7" Padding="18" Margin="0,0,0,25"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="파일 이름 검색" FontSize="13"/><TextBlock Text="자체 로컬 인덱스" FontSize="12" Foreground="#909090" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="1·2·4분할 탐색" FontSize="13"/><TextBlock Text="패널별 독립 탭" FontSize="12" Foreground="#909090" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="8가지 보기" FontSize="13"/><TextBlock Text="파일 미리보기" FontSize="12" Foreground="#909090" Margin="0,7,0,0"/></StackPanel></Grid></Border>
    <TextBlock Text="다음 화면에서 설치 위치와 바로가기를 선택할 수 있습니다." FontSize="12" Foreground="#A5A5A5" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel Name="OptionsPage" Visibility="Collapsed"><TextBlock Text="QuadFinder 설치" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="파일 검색과 탐색을 하나의 작업 공간에서." Foreground="#A5A5A5" Margin="0,0,0,30"/>
    <TextBlock Text="설치 위치" FontSize="13" Margin="0,0,0,10"/><Grid Margin="0,0,0,27"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><TextBox Name="InstallPath" AutomationProperties.Name="설치 위치" FontSize="12"/><Button Name="BrowseButton" Grid.Column="2" Content="변경" Padding="10,9"/></Grid>
    <TextBlock Text="바로가기" FontSize="13" Margin="0,0,0,14"/><CheckBox Name="StartMenuCheck" Content="시작 메뉴에 추가" IsChecked="True"/><CheckBox Name="DesktopCheck" Content="바탕 화면에 바로가기 만들기" IsChecked="False"/>
   </StackPanel>
   <StackPanel Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock Name="ProgressTitle" Text="설치를 준비하고 있습니다" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Name="ProgressText" Text="필요한 파일을 준비하는 중입니다." Foreground="#A5A5A5" Margin="0,0,0,25"/><ProgressBar Name="InstallProgress" Height="5" Foreground="#C5CDD7" Background="#383838" BorderThickness="0"/><TextBlock Name="ProgressDetail" Foreground="#A5A5A5" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel>
   <StackPanel Name="FinishPage" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock Text="설치가 완료되었습니다" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="QuadFinder를 사용할 준비가 되었습니다." Foreground="#A5A5A5" Margin="0,0,0,28"/><Border Background="#181818" CornerRadius="7" Padding="16" Margin="0,0,0,24"><StackPanel><TextBlock Text="설치된 위치" Foreground="#A5A5A5" FontSize="12" Margin="0,0,0,6"/><TextBlock Name="InstalledPath" TextWrapping="Wrap" FontSize="13"/></StackPanel></Border><CheckBox Name="RunCheck" Content="닫은 뒤 QuadFinder 실행" IsChecked="False"/></StackPanel>
   <TextBlock Name="ErrorText" TextWrapping="Wrap" Foreground="#E5A5A1" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#383838" BorderThickness="0,1,0,0" Background="#1D1D1D"><Grid Margin="32,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Name="VersionText" FontSize="12" Foreground="#B8B8B8"/><TextBlock Text="현재 사용자에게 설치 · 자동 업데이트 꺼짐" FontSize="11" Foreground="#909090" Margin="0,4,0,0"/></StackPanel><Button Name="CancelButton" Grid.Column="1" Content="취소" Background="Transparent" VerticalAlignment="Center"/><Button Name="PrimaryButton" Grid.Column="3" Content="다음" Background="#C5CDD7" Foreground="#181818" BorderBrush="#C5CDD7" FontWeight="SemiBold" MinWidth="96" VerticalAlignment="Center"/></Grid></Border>
 </Grid></Border>
</Window>
