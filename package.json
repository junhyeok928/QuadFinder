{
  "name": "quadfinder",
  "productName": "QuadFinder",
  "version": "0.14.0-beta.4",
  "private": true,
  "description": "빠른 파일 검색과 다중 패널 탐색을 결합한 Windows 파일 관리자",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "preview": "node scripts/preview.cjs",
    "icon:build": "electron scripts/build-icon.cjs",
    "design:check": "electron . --design-preview",
    "smoke": "electron . --smoke-test",
    "package": "node scripts/package.cjs",
    "wizard": "node scripts/wizard.cjs",
    "wizard:check": "node scripts/check-wizard.cjs",
    "release": "node scripts/package.cjs",
    "package:check": "node scripts/check-package.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@electron/packager": "20.3.0",
    "electron": "44.7.1"
  }
}
